<section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-copy"><span class="envelope" aria-hidden="true">✉</span><div><p class="eyebrow">Read at your own pace</p><h2 id="newsletter-title">Follow {{ site.title }}.</h2><p>New writing, without having to check back here.</p></div></div>
  <div class="newsletter-action">
    {% if integrations.buttondown and site.isProduction %}
    <form action="https://buttondown.com/api/emails/embed-subscribe/{{ integrations.buttondown }}" method="post">
      <label for="newsletter-email">Get new posts by email</label>
      <div class="form-row"><input id="newsletter-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required><button type="submit">Subscribe <span aria-hidden="true">→</span></button></div>
      <input type="hidden" name="embed" value="1">
      <p class="fine-print">Via Buttondown. Unsubscribe anytime. <a href="/privacy/">Privacy</a></p>
    </form>
    {% else %}
    <a class="retro-button" href="/follow/">How to follow <span aria-hidden="true">→</span></a>
    <p class="fine-print">Use an RSS reader. No signup needed.<br>Our guide explains how to get started.</p>
    {% endif %}
  </div>
</section>
