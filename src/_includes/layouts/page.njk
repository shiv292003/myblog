<article class="page-article">
  <header class="article-header"><p class="eyebrow">{{ eyebrow or site.title }}</p><h1>{{ title }}</h1>{% if description %}<p class="article-deck">{{ description }}</p>{% endif %}</header>
  <div class="prose">{{ content | safe }}</div>
</article>
